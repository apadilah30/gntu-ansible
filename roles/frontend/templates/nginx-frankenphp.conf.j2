# Managed by Ansible - GNTU CMS reverse proxy to FrankenPHP (Octane worker mode)
# Deployed only when frontend_runtime == "frankenphp".
# Static assets are still served straight from disk; everything else is proxied
# to the persistent FrankenPHP workers.
upstream frankenphp_gntu {
    server {{ frankenphp_listen }};
    keepalive 32;
}

server {
    listen 80;
    server_name {{ frontend_server_name }};

    root {{ frontend_dir }}/public;
    index index.php;

    add_header X-Frame-Options "SAMEORIGIN";
    add_header X-Content-Type-Options "nosniff";
    add_header X-XSS-Protection "1; mode=block";
    client_max_body_size 20M;

    # Serve built assets and static files directly (no PHP round-trip).
    location /build {
        root {{ frontend_dir }}/public;
        try_files $uri =404;
        expires 1y;
        access_log off;
    }

    location ~ /\.ht {
        deny all;
    }

    # Everything else -> FrankenPHP.
    location / {
        proxy_pass http://frankenphp_gntu;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";
        # Safety net: fail fast instead of hanging for minutes on a stuck worker.
        proxy_read_timeout {{ frankenphp_proxy_read_timeout }};
        proxy_connect_timeout 5s;
    }

    access_log /var/log/nginx/gntu_cms_access.log;
    error_log /var/log/nginx/gntu_cms_error.log;
}
