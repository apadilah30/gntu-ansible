# Managed by Ansible - GNTU CMS (Laravel Octane / FrankenPHP worker mode)
[Unit]
Description=GNTU CMS Laravel Octane (FrankenPHP)
After=network.target redis-server.service postgresql.service
Wants=redis-server.service

[Service]
Type=simple
User={{ deploy_user }}
Group={{ deploy_group }}
WorkingDirectory={{ frontend_dir }}
# www-data has no writable $HOME; give FrankenPHP/Caddy a writable config+data dir
# to avoid "config autosave"/"clean storage" warnings.
Environment=XDG_CONFIG_HOME={{ frankenphp_data_dir }}/config
Environment=XDG_DATA_HOME={{ frankenphp_data_dir }}/data
ExecStart=/usr/bin/php artisan octane:start \
    --server=frankenphp \
    --host={{ frankenphp_listen.split(':')[0] }} \
    --port={{ frankenphp_listen.split(':')[1] }} \
    --workers={{ frankenphp_workers }} \
    --max-requests={{ frankenphp_max_requests }}
# Persistent workers: the app boots once and stays in memory (fast).
# --max-requests recycles workers to avoid leaks. A slow Http:: call without a
# timeout will exhaust these FEW workers quickly, so the README 5.2 fixes are
# MANDATORY before switching to this runtime.
ExecReload=/usr/bin/php artisan octane:reload
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=gntu-cms-octane

[Install]
WantedBy=multi-user.target
