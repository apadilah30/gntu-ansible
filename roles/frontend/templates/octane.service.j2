# Managed by Ansible - GNTU CMS (Laravel Octane / FrankenPHP)
[Unit]
Description=GNTU CMS Laravel Octane ({{ frontend_octane_server }})
After=network.target redis-server.service postgresql.service
Wants=redis-server.service

[Service]
Type=simple
User={{ deploy_user }}
Group={{ deploy_group }}
WorkingDirectory={{ frontend_dir }}
ExecStart=/usr/bin/php artisan octane:start \
    --server={{ frontend_octane_server }} \
    --host=127.0.0.1 \
    --port={{ frontend_port }} \
    --workers={{ frontend_octane_workers }} \
    --max-requests={{ frontend_octane_max_requests }}
# --workers sized to CPU: too few workers -> requests queue INSIDE Octane and
# never reach the backend, producing an nginx 504 with no gateway log.
# --max-requests recycles workers to avoid slow memory/handle leaks under Octane.
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=gntu-cms-octane

[Install]
WantedBy=multi-user.target
