# Managed by Ansible
global:
  scrape_interval: {{ prometheus_scrape_interval }}
  evaluation_interval: {{ prometheus_scrape_interval }}

rule_files:
  - /etc/prometheus/rules/*.yml

alerting:
  alertmanagers:
    - static_configs:
        - targets: ["127.0.0.1:9093"]

scrape_configs:
  - job_name: prometheus
    static_configs:
      - targets: ["127.0.0.1:9090"]

  - job_name: node
    static_configs:
      - targets: ["127.0.0.1:9100"]

  - job_name: nginx
    static_configs:
      - targets: ["127.0.0.1:9113"]

{% if frontend_runtime | default('fpm') == 'fpm' %}
  # PHP-FPM pool metrics (FE). Child exhaustion + listen queue = the 504 cause.
  - job_name: phpfpm
    static_configs:
      - targets: ["127.0.0.1:9253"]
{% endif %}

  - job_name: redis
    static_configs:
      - targets: ["127.0.0.1:9121"]

  - job_name: postgres
    static_configs:
      - targets: ["127.0.0.1:9187"]

  # Gunicorn worker metrics (busy/idle/requests) via statsd_exporter.
  # THIS is what reveals worker saturation while CPU looks idle.
  - job_name: gunicorn
    static_configs:
      - targets: ["127.0.0.1:9102"]

  # Django app metrics (requires django-prometheus in each service; see README).
  - job_name: django
    metrics_path: /metrics
    static_configs:
      - targets:
{% for svc in backend_services %}
          - "127.0.0.1:{{ svc.port }}"
{% endfor %}

  # Blackbox uptime probing of public + local endpoints.
  - job_name: blackbox_http
    metrics_path: /probe
    params:
      module: [http_2xx]
    static_configs:
      - targets:
{% for t in blackbox_targets %}
          - "{{ t }}"
{% endfor %}
    relabel_configs:
      - source_labels: [__address__]
        target_label: __param_target
      - source_labels: [__param_target]
        target_label: instance
      - target_label: __address__
        replacement: 127.0.0.1:9115
