# Managed by Ansible
[server]
http_addr = 127.0.0.1
http_port = {{ grafana_port }}
# Grafana is bound to localhost. Expose it via nginx reverse proxy (see README),
# never directly to the internet.

[security]
admin_user = {{ grafana_admin_user }}
admin_password = {{ grafana_admin_password }}

[users]
allow_sign_up = false
